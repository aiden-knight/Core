		"reveal": "always",
	},
	{
		"label": "Force rebuild: tests (release)",
		"command": "builder",
		"args": ["build.cpp", "--config=tests", "--release", "--force-rebuild"],
		"cwd": "$ZED_WORKTREE_ROOT",
		"allow_concurrent_runs": false,
