[
	{
		"label": "Build: core (debug)",
		"command": "builder",
		"args": ["build.cpp", "--config=core"],
		"cwd": "$ZED_WORKTREE_ROOT",
		"allow_concurrent_runs": false,
		"reveal": "always",
	},
	{
		"label": "Force rebuild: core (debug)",
		"command": "builder",
		"args": ["build.cpp", "--config=core", "--force-rebuild"],
		"cwd": "$ZED_WORKTREE_ROOT",
		"allow_concurrent_runs": false,
		"reveal": "always",
	},
	{
		"label": "Build: core (release)",
		"command": "builder",
		"args": ["build.cpp", "--config=core", "--release"],
		"allow_concurrent_runs": false,
		"reveal": "always",
	},
	{
		"label": "Force rebuild: core (release)",
		"command": "builder",
		"args": ["build.cpp", "--config=core", "--release", "--force-rebuild"],
		"cwd": "$ZED_WORKTREE_ROOT",
		"allow_concurrent_runs": false,
		"reveal": "always",
	},

	{
		"label": "Build: tests (debug)",
		"command": "builder build.cpp --config=tests",
		"cwd": "$ZED_WORKTREE_ROOT",
		"allow_concurrent_runs": false,
		"reveal": "always",
	},
